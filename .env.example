# Generate a key with: python3 -c 'import secrets; print(secrets.token_hex(32))'
API_KEY=replace-with-a-random-local-key
HF_TOKEN=

# Physical GPU indexes or GPU UUIDs from nvidia-smi. Do not overlap assignments.
OMNI_GPU=0
EMBED_GPU=1
OMNI_7B_GPU_A=2
OMNI_7B_GPU_B=3
OMNI_PORT=8000
EMBED_PORT=8001
OMNI_7B_PORT=8002
OMNI_CONTEXT=4096
VIDEO_LIMIT=0

# Compatibility baseline, not a claim that these are the latest releases.
VLLM_IMAGE=vllm/vllm-openai:v0.10.2
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:turing-1.8
# Replace main with exact Hugging Face commit IDs before a scored run.
OMNI_REVISION=main
OMNI_7B_REVISION=main
EMBED_REVISION=main
